# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by import scripts + server actions. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email of the single account allowed to claim ownership of the collection.
# When this user signs in, the auth callback inserts their UUID into
# owner_config (idempotent), unlocking writes (Add, Sync) for them. No effect
# for any other email. Server-only — never exposed to the browser.
OWNER_EMAIL=

# Dev-only auth bypass for Playwright/local debugging. When set to "1",
# getUser() returns a fake owner and isOwner() returns true unconditionally,
# without touching Supabase. Never enable in production.
# DEV_AUTH_BYPASS=1

# IGDB via Twitch (dev.twitch.tv → Applications → register + get client id/secret)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# BGG username (e.g. oktano_) — drives `/xmlapi2/collection?username=…`.
BGG_USERNAME=

# BGG XML API2 requires a registered application token as of 2026.
# Register at https://boardgamegeek.com/applications (approval can take up to a week).
BGG_AUTH_TOKEN=

# BGG account password — used by the sync scripts to grab a session cookie via
# POST https://boardgamegeek.com/login/api/v1, so that ?showprivate=1 returns
# acquisitiondate / pricepaid / etc. Bearer token alone won't unlock those.
BGG_PASSWORD=

# Ludopedia personal API token — instant, no approval wait.
# Generate at https://ludopedia.com.br/configuracoes/api (while logged in).
# Used as a fallback/alternative to BGG for Brazilian / Portuguese board game data.
LUDOPEDIA_TOKEN=

# GitHub fine-grained PAT used by the in-app "Sincronizar agora" button to
# trigger the sync-ludopedia workflow via workflow_dispatch.
# Scope: repository "eliasqueirogavieira/webapp", permission Actions: Read and write.
# Generate at github.com/settings/tokens?type=beta
GH_DISPATCH_TOKEN=
